 * Author : Aditya Shakya (adi1090x)
 * Github : @adi1090x
 *
 * Rofi Theme File - Horizontal Powermenu Card (Nord Theme - Perfect Circles)
 * Rofi Version: 1.7.3
 **/

/*****----- Configuration -----*****/
configuration {
    show-icons:                 false;
}

/*****----- Global Properties (Nord Palette) -----*****/
* {
    font:                        "MesloLGS Nerd Font 10";
    element-text-font:           "feather 28";

    /* Nord Colors */
    background-window:           #2E3440; /* nord0: Polar Night Dark */
    background-element:          #3B4252; /* nord1: Polar Night Card */
    background-selected:         #88C0D0; /* nord8: Frost Cyan Accent */

    foreground-normal:           #D8DEE9; /* nord4: Snow Storm White */
    foreground-selected:         #2E3440; /* nord0: Polar Night Dark */

    accent-color:                #88C0D0; /* nord8: Frost Cyan */
}

/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    south;
    anchor:                      south;
    fullscreen:                  false;
    width:                       510px; /* Calibrated so 5 columns equal 80px wide each */
    x-offset:                    0px;
    y-offset:                    -20px;

    padding:                     25px;
    background-color:            var(background-window);
    border-radius:               0px; /* Sharp square outer window container */
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    orientation:                 vertical;
    spacing:                     15px;
    background-color:            transparent;
    children:                    [ "message", "listview" ];
}

/*****----- Message / System Info Bar -----*****/
message {
    enabled:                     true;
    padding:                     0px;
    background-color:            transparent;
    border:                      1px;
    border-color:                var(accent-color);
    border-radius:               0px;
}

textbox {
    padding:                     10px;
    background-color:            var(background-element);
    text-color:                  var(foreground-normal);
    vertical-align:              0.5;
    horizontal-align:            0.5;
    border-radius:               0px;
}

/*****----- Listview (Horizontal Row) -----*****/
listview {
    enabled:                     true;
    columns:                     5;
    lines:                       1;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    spacing:                     15px;
    background-color:            transparent;
    cursor:                      "default";
    fixed-height:                true;
    fixed-columns:               true;
}

/*****----- Elements (True Circle Buttons) -----*****/
element {
    enabled:                     true;
    padding:                     23px 0px; /* Top/bottom padding tuned to 80px height */
    border-radius:               100%;     /* Turns 80x80 square into a perfect circle */
    background-color:            var(background-element);
    text-color:                  var(foreground-normal);
    cursor:                      pointer;
}

element-text {
    font:                        var(element-text-font);
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}

element selected.normal {
    background-color:            var(background-selected);
    text-color:                  var(foreground-selected);
}
